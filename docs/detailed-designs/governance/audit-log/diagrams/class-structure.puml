@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Audit log

enum AuditAction {
  SignIn
  DirectionSubmitted
  Pause
  Resume
  Cancel
  Merge
  TokenCreated
  TokenRevoked
  StopAll
  StartWorkers
}
class AuditEntry {
  +long Id
  +DateTimeOffset At
  +string Actor
  +AuditAction Action
  +Guid? ProjectId
  +string? ProjectName
  +string? Target
  +string? IpAddress
}
interface IRequestOrigin {
  +string? IpAddress
}
class AuditWriter {
  +Record(action, actor, project): void
  +Record(action, actor, target): void
  +RecordMerge(actor, project, pullRequest): void
}
class GetAuditLogHandler {
  +Handle(GetAuditLogQuery): Task<AuditLogDto>
}
class AuditController {
  +List(project?, action?, before?, limit?): Task<AuditLogDto>
}
AuditEntry --> AuditAction
AuditWriter ..> AuditEntry : adds (caller saves)
AuditWriter --> IRequestOrigin : IP
AuditController ..> GetAuditLogHandler : sends
GetAuditLogHandler ..> AuditEntry : reads
@enduml
