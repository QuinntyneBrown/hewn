@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Preview designs and the design system

System_Ext(gh, "GitHub", "The project's repository: docs/mocks/ and docs/design-system/")
Container_Boundary(spa_b, "Mission Control (localhost / app origin)") {
  Component(designs, "DesignsComponent", "Angular, Designs tab of ProjectPage", "Screens and states with live thumbnails and Magic Patterns links")
  Component(prev, "SandboxedPreviewComponent", "Angular component", "Iframe sandbox=allow-scripts at 375-1200 px, light or dark")
}
Container_Boundary(api_b, "Hewn API") {
  Component(ctrl, "ProjectsController", "ASP.NET Core", "GET /api/projects/{id}/designs, session required")
  Component(list, "GetDesignsHandler", "MediatR", "Reads docs/mocks/manifest.json at the head; signs preview URLs")
  Component(tok, "PreviewTokens", "HMAC-SHA256", "{project}.{sha}.{expiry}, 60 minutes")
  Component(host, "PreviewEndpoint + ServePreviewHandler", "Minimal API on the preview host only", "GET /preview/{token}/{path}; CSP sandbox; no cookies")
}

Rel(designs, prev, "Uses")
Rel(designs, ctrl, "GET designs", "JSON/HTTPS")
Rel(ctrl, list, "Sends GetDesignsQuery")
Rel(list, tok, "Signs")
Rel(list, gh, "Reads the manifest at the head")
Rel(prev, host, "iframe src on the preview origin", "HTTPS")
Rel(host, tok, "Verifies")
Rel(host, gh, "Reads the file at the signed SHA (cached)")
@enduml
