@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Preview designs and the design system

class DesignsComponent <<Angular>> {
  +projectId: input<string>
  +width: Signal<375 | 576 | 768 | 992 | 1200>
  +theme: Signal<'light' | 'dark'>
  -chosen: Signal<string | null>
}
class SandboxedPreviewComponent <<Angular>> {
  +url: input<string>
  +width: input<number>
  +theme: input<'light' | 'dark'>
  #src: SafeResourceUrl (url?theme=)
  #scale: frame width / width
}
class DesignsDto {
  +Sha: string?
  +StateCount: int
  +Screens: DesignScreenDto[]
}
class DesignScreenDto {
  +Screen: string
  +Title: string
  +MagicPatternsUrl: string?
  +States: DesignStateDto[]
}
class DesignStateDto {
  +State: string
  +Label: string
  +Path: string
  +PreviewUrl: string
}
class GetDesignsHandler <<MediatR>> {
  +Handle(GetDesignsQuery): DesignsDto
}
class PreviewTokens {
  -key: byte[32] made at start-up
  +Sign(projectId, sha): string
  +Read(token): PreviewGrant?
  +Url(token, path): string
}
class ServePreviewHandler <<MediatR>> {
  +Handle(ServePreviewQuery): PreviewFile
  -allowedRoots = [docs/mocks/, docs/design-system/]
}
class PreviewOptions {
  +Origin: string
  +TokenMinutes = 60
}
interface IGitHubRepositories {
  +ReadFileAsync(owner, name, path, sha?): RepositoryContent?
}
DesignsComponent *-- SandboxedPreviewComponent
DesignsComponent ..> DesignsDto : GET /api/projects/{id}/designs
DesignsDto *-- DesignScreenDto
DesignScreenDto *-- DesignStateDto
GetDesignsHandler ..> PreviewTokens : signs
GetDesignsHandler ..> IGitHubRepositories
ServePreviewHandler ..> PreviewTokens : verifies
ServePreviewHandler ..> IGitHubRepositories
PreviewTokens ..> PreviewOptions
SandboxedPreviewComponent ..> ServePreviewHandler : iframe on the preview origin
@enduml
