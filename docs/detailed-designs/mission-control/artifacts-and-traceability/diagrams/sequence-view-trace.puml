@startuml
title UML sequence behaviour — View a trace
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "TraceabilityComponent" as tpage
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as tctrl
  participant "GetTraceabilityHandler" as handler
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
user -> tpage : Open Traceability?l2=L2-020
tpage -> tctrl : GET /api/projects/{id}/traceability
tctrl -> handler : GetTraceabilityQuery (404 for an unknown project)
handler -> gh : Download the archive at the head (f61a2d8)
handler -> handler : Parse L2.md (502 naming the commit and line if it can't);\nL1 titles, design READMEs, journeys, test headers
handler -> gh : List pull requests
handler -> handler : Match each L2 ID whole in designs, journeys, Traces to: headers and PR titles
handler --> tpage : Every L2 with L1, designs, journeys, tests, PRs (L2-035 AC1)
tpage --> user : The L2's trace; "No acceptance test" unless Deferred (L2-035 AC2)
note over tpage : Reads again on StageChanged and IncrementChanged
@enduml
