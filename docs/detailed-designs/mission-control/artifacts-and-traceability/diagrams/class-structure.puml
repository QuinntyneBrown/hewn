@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Artifacts and traceability

class GetArtifactsHandler {
  +Handle(q: GetArtifactsQuery): ArtifactsDto
}
class ArtifactsDto {
  +string? Repository
}
class StageArtifactsDto {
  +int Stage
  +string Name
}
class VersionedArtifactDto {
  +string Path
  +bool Folder
  +string Sha
  +DateTimeOffset CommittedAt
  +string? Url
}
class GetTraceabilityHandler {
  +Handle(q: GetTraceabilityQuery): TraceabilityDto
}
class TraceabilityDto {
  +string? Repository
  +string? Commit
}
class RequirementTraceDto {
  +string Id
  +string Title
  +string? Deferred
  +bool NoAcceptanceTest
  +string[] Tests
}
class ParentRequirementDto {
  +string Id
  +string Title
}
class TracedDesignDto {
  +string Title
  +string Path
}
class TracedJourneyDto {
  +int Number
  +string Title
}
class TracedPullRequestDto {
  +int Number
  +string Title
  +string Url
  +bool Merged
}
GetArtifactsHandler ..> ArtifactsDto : builds from github_mutations
ArtifactsDto "1" *-- "*" StageArtifactsDto
StageArtifactsDto "1" *-- "*" VersionedArtifactDto
GetTraceabilityHandler ..> TraceabilityDto : builds from the archive and pull requests
TraceabilityDto "1" *-- "*" RequirementTraceDto
RequirementTraceDto --> "0..1" ParentRequirementDto : L1
RequirementTraceDto "1" *-- "*" TracedDesignDto
RequirementTraceDto "1" *-- "*" TracedJourneyDto
RequirementTraceDto "1" *-- "*" TracedPullRequestDto
@enduml
