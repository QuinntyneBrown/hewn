@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Artifacts and traceability

Container(worker, "Worker", "Container image, Claude Agent SDK", "Leases runs and executes stages, local or cloud")
Container(spa, "Mission Control", "Angular", "Web frontend: give direction and watch the work")
ContainerDb(db, "Hewn database", "Relational database, engine <TO SUPPLY>", "Projects, directions, runs, events, spend, audit")
Container_Boundary(api_b, "Hewn API") {
  Component(broker, "CommitFilesHandler", "GitHub broker", "Commits a stage's files; records SHA, paths, branch")
  Component(rec, "GetArtifactsHandler", "Read model", "Artifact = path + latest commit SHA of a succeeded run")
  Component(idx, "TraceIndexer", "Background job", "Builds trace links at a SHA")
  Component(actrl, "ProjectsController", "ASP.NET Core controller", "GET /api/projects/{id}/artifacts")
  Component(tctrl, "TraceabilityController", "ASP.NET Core controller", "Trace for an L2")
}
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")

Rel(worker, broker, "Commit files", "HTTPS")
Rel(broker, github, "Commits", "HTTPS")
Rel(broker, db, "Inserts github_mutations", "SQL")
Rel(rec, db, "Reads succeeded runs' commits", "SQL")
Rel(rec, idx, "Planned: triggers after stages 5, 7, 8, merges (L2-035)")
Rel(idx, github, "Reads files at SHA", "HTTPS")
Rel(idx, db, "Rebuilds trace_links", "SQL")
Rel(spa, actrl, "GET", "JSON/HTTPS")
Rel(spa, tctrl, "GET", "JSON/HTTPS")
Rel(actrl, rec, "Sends GetArtifactsQuery")
Rel(tctrl, db, "Reads", "SQL")
@enduml
