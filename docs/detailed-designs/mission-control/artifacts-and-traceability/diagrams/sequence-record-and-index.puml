@startuml
title UML sequence behaviour — Record artifacts and index traces
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Worker application" #D1FADF
  participant "WorkerHost" as worker
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "CommitFilesHandler" as rec
  participant "TraceIndexer" as idx
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
worker -> rec : Commit(stage 5, docs/specs/L1.md, docs/specs/L2.md)
rec -> gh : Commit to the default branch
gh --> rec : sha f61a2d8
rec -> db : Insert github_mutation (sha, paths, branch, time)
worker -> db : RunSucceeded — the commit is now the artifacts' version (L2-034 AC1)
note over idx : Planned for L2-035
db -> idx : RebuildAsync(project, f61a2d8)
idx -> gh : Read specs, designs, journeys, test headers, PR titles at SHA
idx -> db : Replace trace_links for project
@enduml
