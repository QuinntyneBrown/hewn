@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Responsive, accessible and themed UI

class StatusAnnouncer <<Angular>> {
  +message: Signal<string>
  +announce(p: ProjectId, msg: string): void
  -slots: Map<ProjectId, {at, pending, timer}>
}
class ProjectPage <<Angular>>
class ProjectsPage <<Angular>>
enum ThemeChoice {
  light
  dark
  system
}
class ThemeService <<Angular>> {
  +choice: Signal<ThemeChoice>
  +choose(c: ThemeChoice): void
}
class "theme.ts functions" as ThemeFns <<TypeScript>> {
  +THEME_KEY = "hewn.theme"
  +readTheme(storage): ThemeChoice
  +saveTheme(storage, c): void
  +applyTheme(root, c): void
}
class SettingsPage <<Angular>> {
  #themes: Light, Dark, System
}
class AppShell <<Angular>> {
  -menu: TemplateRef
  #openMenu(): void
  #closeMenu(): void
}
class "Menu drawer" as MenuDrawer <<CDK Dialog>> {
  ariaLabel = "Menu"
  autoFocus = first-tabbable
}
ThemeService --> ThemeChoice
ThemeService ..> ThemeFns : data-theme on <html>,\nlocalStorage
SettingsPage ..> ThemeService : Appearance radios
AppShell *-- MenuDrawer : below 992 px
AppShell ..> StatusAnnouncer : renders message\nin role=status, polite
ProjectPage ..> StatusAnnouncer : StageChanged
ProjectsPage ..> StatusAnnouncer : row stage or status changed
@enduml
