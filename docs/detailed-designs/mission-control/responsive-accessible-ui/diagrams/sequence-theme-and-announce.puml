@startuml
title UML sequence behaviour — Apply the theme and announce status changes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "index.html" as boot
  participant "Settings" as settings
  participant "ThemeService" as theme
  participant "Project page or Projects" as live
  participant "AppShell" as shell
  participant "StatusAnnouncer" as ann
end box
box "Backend — Hewn API application" #D1FADF
  participant "MissionControlHub" as hub
end box
theme -> theme : No saved choice: no data-theme, so prefers-color-scheme decides, live (L2-048 AC1)
user -> settings : Choose Dark in Appearance
settings -> theme : choose(dark)
theme -> theme : data-theme=dark; localStorage hewn.theme = dark
user -> boot : Reload
boot -> boot : data-theme=dark before the first paint (L2-048 AC2)
boot -> theme : App starts; choice() = dark, Dark checked
hub -> live : StageChanged x3 within 2 s (Ledgerline)
live -> ann : announce(Ledgerline, msg) each time
ann -> shell : message = first change at once
ann -> ann : Keep the latest; Tidewater's changes are not held back
ann -> shell : message = latest change after 5 s (L2-047 AC3)
shell -> user : Screen reader reads the polite region
@enduml
