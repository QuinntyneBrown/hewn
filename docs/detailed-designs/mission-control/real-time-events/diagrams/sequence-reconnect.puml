@startuml
title UML sequence behaviour — Reconnect and catch up
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Frontend — Mission Control application" #E0F2FE
  participant "Shell" as banner
  participant "SignalRProjectEvents" as live
  participant "Reconnector" as rec
end box
box "Backend — Hewn API application" #D1FADF
  participant "MissionControlHub" as hub
  participant "EventsController" as ctrl
end box
hub -> live : onclose (network dropped)
live -> rec : dropped()
loop after 0, 2, 10, 30 s, then every 30 s; Retry now tries at once
  rec -> banner : status reconnecting (offline after the fourth attempt), next attempt at t (L2-032 AC1)
  banner -> banner : "Reconnecting… next attempt in n s. Missed events will catch up from #seq."
  rec -> live : reconnect()
  live -> hub : start()
end
hub --> live : Connected
loop each open subscription
  live -> hub : JoinProject(id) / JoinProjects / JoinWorkers
  live -> ctrl : GET /api/projects/{id}/events?after=lastSeq (pages until empty)
  ctrl --> live : Missed events in order
  live -> live : Apply each once; skip seq <= lastSeq; count them (L2-032 AC2)
end
live -> banner : caughtUp {count, from, to}
rec -> banner : status live
banner -> banner : "Reconnected. Caught up n missed events, #from to #to." for 5 s, then gone (L2-032 AC3)
@enduml
