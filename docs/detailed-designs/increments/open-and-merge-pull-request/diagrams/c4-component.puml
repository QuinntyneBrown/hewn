@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Open and merge the pull request

Container(worker, "Worker", "Node.js, Claude Agent SDK", "Leases runs and executes stages, local or cloud")
Container(spa, "Mission Control", "Angular", "IncrementPage: timeline, pull request, required checks")
ContainerDb(db, "Hewn database", "Relational database (SQLite in tests and e2e)", "increments, increment_checks, events")
Container_Boundary(api_b, "Hewn API") {
  Component(broker, "WorkerController + GitHub mutations", "ASP.NET Core, MediatR", "Fenced, idempotent commit / open / merge; increment progress")
  Component(checks, "GetPullRequestChecksHandler", "MediatR handler", "The worker's check reads")
  Component(hook, "GitHubWebhookController", "ASP.NET Core controller", "Verifies X-Hub-Signature-256; 401 and logged otherwise")
  Component(poll, "CheckPoller", "Background service", "Reads checks after 60 s of silence")
  Component(recorder, "CheckRecorder", "Application service", "Stores checks; emits CheckChanged")
  Component(detail, "GetIncrementHandler", "MediatR handler", "GET /api/projects/{id}/increments/{n}")
  Component(hub, "MissionControlHub", "SignalR hub", "Pushes events to Mission Control")
}
System_Ext(github, "GitHub", "Target repositories, pull requests, checks and webhooks")
Rel(worker, broker, "Mutations and progress + epoch", "JSON/HTTPS")
Rel(worker, checks, "Check reads", "JSON/HTTPS")
Rel(broker, github, "PR writes", "HTTPS")
Rel(github, hook, "check_run", "HTTPS")
Rel(checks, github, "GET checks", "HTTPS")
Rel(poll, github, "GET checks", "HTTPS")
Rel(hook, recorder, "Check change")
Rel(checks, recorder, "Check states")
Rel(poll, recorder, "Check states")
Rel(recorder, db, "Stores", "SQL")
Rel(recorder, hub, "CheckChanged")
Rel(detail, db, "Reads", "SQL")
Rel(detail, github, "GET pull request", "HTTPS")
Rel(spa, detail, "GET increment", "JSON/HTTPS")
Rel(hub, spa, "Pushes", "SignalR")
@enduml
