@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Open and merge the pull request

class IncrementStageExecutor <<worker>> {
  -deliver(increment): Merged | Blocked
  -waitForChecks(number): CheckRun[]
  -rebase(): up to 3 attempts
}
class "pull-request.ts" as PrTemplate <<worker>> {
  +pullRequestTitle(journey, increment): string
  +pullRequestBody(facts): string
}
class Increment {
  +Status: IncrementStatus
  +TestCount, RedFailing, RedPassing: int?
  +Iterations: int
  +GreenAfter: int?
  +Video, VideoNote: string?
  +PullRequestNumber: int?
  +StartedAt, TestsCommittedAt, GreenAt, VideoAt
  +PullRequestOpenedAt, FinishedAt, ChecksHeardAt
  +Apply(progress: IncrementProgress, now): bool
  +HeardChecks(now)
}
class IncrementCheck {
  +PullRequestNumber: int
  +Name, Status: string
  +Conclusion: string?
  +StartedAt, CompletedAt
  +Update(status, conclusion, started, completed): bool
}
class GitHubWebhookController {
  +Receive(): 202 | 401
}
class WebhookSignature <<static>> {
  +Problem(secret, body, header): string?
}
class CheckRecorder {
  +FindAsync(project, number): Increment?
  +RecordAsync(project, increment, checks)
}
class CheckPoller {
  +Silence: TimeSpan = 60 s
  +PollAsync(): int
}
class GetIncrementHandler {
  +Handle(GetIncrementQuery): IncrementDetailDto
}
class IncrementPage <<Angular>> {
  +timeline: TimelineStep[]
  +checks
}
IncrementStageExecutor ..> PrTemplate
Increment "1" *-- "*" IncrementCheck
GitHubWebhookController ..> WebhookSignature
GitHubWebhookController ..> CheckRecorder : RecordCheckRunCommand
CheckPoller ..> CheckRecorder
CheckRecorder ..> IncrementCheck : CheckChanged
GetIncrementHandler ..> Increment
GetIncrementHandler ..> IncrementCheck
IncrementPage ..> GetIncrementHandler : GET increments/{n}
@enduml
