@startuml
title UML sequence behaviour — Poll checks when no webhook arrives
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Hewn Infrastructure" #FFF4E5
  participant "CheckPoller" as poll
  database "Hewn database" as db
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "CheckStatusProjector" as proj
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
loop every 60 s
  poll -> db : Open PRs with no webhook in the last 60 s
  poll -> gh : GET /repos/{repo}/commits/{sha}/check-runs
  gh --> poll : Check states
  poll -> proj : Changed states only
  proj -> db : Store; emit CheckChanged (L2-031)
end
@enduml
