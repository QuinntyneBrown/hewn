@startuml
title UML sequence behaviour — Fence a stale worker
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Worker application" #D1FADF
  participant "WorkLoop (stale worker)" as w1
end box
box "Backend — Hewn API application" #ECFDF3
  participant "Mutation handlers" as broker
  participant "LeaseService" as lease
  participant "RunWriteLock" as lock
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
w1 -> broker : Commit(run, epoch 1)
broker -> lease : FenceForWriteAsync(run, worker, epoch 1)
lease -> lock : HoldAsync(run)
lease -> db : Leased by this worker at epoch 1: yes
broker -> gh : Commit, still holding the lock
w1 -> w1 : Goes quiet; 60 s pass without a heartbeat
lease -> lock : ExpireStaleAsync: HoldAsync(run) waits
gh --> broker : SHA
broker -> db : Record the mutation by its key
broker -> lock : Release
broker --> w1 : SHA
lock --> lease : Held: the run expires and is leased again with epoch 2
w1 -> broker : Commit(run, epoch 1), or a heartbeat, result or log line
broker -> lease : FenceForWriteAsync(run, worker, epoch 1)
lease -> db : Run.LeaseEpoch = 2, leased by another worker
lease --> w1 : 409 lease_lost; nothing reaches GitHub
w1 -> w1 : Stops the run and reports nothing further
@enduml
