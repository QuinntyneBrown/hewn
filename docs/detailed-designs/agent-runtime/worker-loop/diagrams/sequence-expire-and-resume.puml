@startuml
title UML sequence behaviour — Expire a lease, reconcile and resume from the checkpoint
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "LeaseReaper" as reaper
  participant "LeaseService" as lease
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "WorkerHost (another worker)" as w2
  participant "CheckpointReconciler" as rec
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
reaper -> lease : ExpireStaleAsync(now) every 10 s and at start-up (L2-050 AC2)
lease -> db : Leases with no heartbeat for 60 s
lease -> db : Delete lease; run back to queue with recorded Checkpoint (L2-026 AC3)
w2 -> lease : TryLease
lease -> db : Acquire RunWriteLock(run): waits for any in-flight broker write to finish
lease -> db : One conditional UPDATE: unleased -> leased by w2; project slot empty -> run; LeaseEpoch 3 -> 4; release lock
alt zero rows changed (another worker won)
  lease --> w2 : Nothing
else
  lease --> w2 : Lease(run, epoch 4, checkpoint {tests, a1b2c3})
  w2 -> rec : ReconcileAsync(run, feature/x)
  rec -> gh : Fetch branch head
  alt head == a1b2c3
    rec --> w2 : Resume at the step after "tests"
  else head ahead; latest Hewn-Checkpoint trailer names "implement"
    rec -> lease : ReportCheckpoint(epoch 4, implement, head) - lost report adopted
    rec --> w2 : Resume at the step after "implement"
  else head ahead; no checkpoint trailer
    rec -> gh : Reset branch to a1b2c3 with --force-with-lease
    rec --> w2 : Resume at the step after "tests"
  else head behind or unrelated
    rec --> w2 : Fail run "Branch diverged from checkpoint" (L2-006)
  end
  w2 -> w2 : Start at the chosen step; no completed step runs twice (L2-050 AC3)
end
@enduml
