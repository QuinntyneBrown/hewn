@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Worker loop, packaging and recovery

Person(owner, "Owner", "Gives direction, watches the work and uses the safety controls")
System(hewn, "Hewn", "Software factory: carries a direction to merged code through a fixed pipeline")
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")
