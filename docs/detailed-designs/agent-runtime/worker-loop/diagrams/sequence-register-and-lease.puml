@startuml
title UML sequence behaviour — Register, lease and heartbeat
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Worker application" #D1FADF
  participant "WorkLoop" as loop
end box
box "Backend — Hewn API application" #D1FADF
  participant "WorkerController" as ctrl
  participant "MissionControlHub" as hub
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "RegisterWorkerHandler" as reg
  participant "HeldLease" as held
  participant "LeaseService" as lease
  participant "WorkSignal" as signal
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Frontend — Mission Control application" #E0F2FE
  participant "WorkersPage" as page
end box
loop -> ctrl : POST /api/worker/register {name, Local or Cloud, host, version}; outbound only (L2-027)
ctrl -> reg : Send
reg -> db : Insert worker
reg -> hub : WorkersChanged to the workers group
hub -> page : Read GET /api/workers again; the row shows within 2 s (L2-026 AC1)
loop
  loop -> ctrl : POST /api/worker/lease?waitSeconds=20
  ctrl -> held : Lease, holding for up to 30 s
  held -> lease : TryLeaseAsync(worker)
  lease -> db : Oldest leasable run whose project has no lease (L2-026 AC4)
  alt run available
    lease --> loop : 200 run, epoch, checkpoint
    loop -> ctrl : Heartbeat every 10 s while running (L2-026 AC2)
  else none yet
    held -> signal : Wait for a stored event (EventAppender pulses it)
    signal --> held : A direction was queued
    held -> lease : TryLeaseAsync again; leased at once (L2-026 AC5)
    note over loop, held : Nothing within the wait: 204, and the worker asks again\n15 s after its last request began, so at most 4 requests a minute
  end
end
@enduml
