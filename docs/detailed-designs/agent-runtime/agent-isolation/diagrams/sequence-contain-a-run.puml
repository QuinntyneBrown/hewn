@startuml
title UML sequence behaviour — Contain a run
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Worker application" #D1FADF
  participant "WorkLoop" as loop
  participant "EgressProxy" as proxy
  participant "RunSandbox" as sandbox
end box
box "Backend — Worker stage execution" #ECFDF3
  participant "StageAgent" as agent
  participant "ToolGate" as gate
end box
box "Backend — Hewn API application" #D1FADF
  participant "WorkerController" as ctrl
end box
box "External systems" #F2F4F7
  participant "Allowed hosts" as ok
end box
loop -> loop : Lease a run; make its workspace (L2-042 AC1)
loop -> proxy : Start this run's proxy: model API, Magic Patterns, npm, NuGet
loop -> agent : Run the stage with ToolGate(stage allowedTools) and the proxy URL
agent -> gate : require("Write")
gate --> agent : Allowed
agent -> gate : require("Bash"), not on the stage's allow list
gate -> loop : "Security event: tool Bash denied" (L2-042 AC3)
gate --> agent : ToolDeniedError
agent -> proxy : CONNECT registry.npmjs.org:443
proxy -> ok : Tunnel
agent -> proxy : CONNECT exfiltrate.example:443
proxy -> loop : "Egress blocked: exfiltrate.example" (L2-042 AC2)
proxy --> agent : 403
loop -> sandbox : Run the gate's commands
sandbox -> sandbox : No worker variable or credential; HTTPS_PROXY only;\nHEWN_SANDBOX=docker: own container, workspace mount, no capabilities,\ninternal network whose only peer is the proxy
loop -> ctrl : Log lines with the run's epoch; commits through the commit mutation, never git to GitHub
note over agent, gate : No tool exposes Hewn configuration, budgets, secrets or another project (L2-042 AC4)
loop -> loop : Run ends: stop the proxy; remove the workspace
@enduml
