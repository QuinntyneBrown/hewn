@startuml
title UML sequence behaviour — Answer health probes
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign left
actor "Load balancer" as lb
box "Backend — Hewn API application" #D1FADF
  participant "Health checks" as health
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database (SQLite)" as db
  queue "SignalR lifetime manager" as bp
end box
lb -> health : GET /health/live
health --> lb : 200 {status: Healthy} (L2-051 AC1)
lb -> health : GET /health/ready
health -> db : New connection, no create; SELECT 1
health -> bp : Send to group "health-probe"
alt both reachable
  health --> lb : 200, each check Healthy
else either unreachable
  health --> lb : 503, the failing check Unhealthy, no error text (L2-051 AC2)
end
@enduml
