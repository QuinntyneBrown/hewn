@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Observability and health checks

System_Boundary(hewn, "Hewn") {
  Container(api, "Hewn API", "ASP.NET Core, SignalR", "REST endpoints, the Mission Control hub and orchestration")
  ContainerDb(db, "Hewn database", "SQLite", "Projects, directions, runs (with their traceparent), events, spend, audit")
  ContainerQueue(backplane, "SignalR lifetime manager", "In-process today (ADR 0035)", "Sends hub messages to clients")
  Container(worker, "Worker", "Node.js", "Leases runs and executes stages, local or cloud")
}
System_Ext(jaeger, "Trace viewer", "Jaeger locally (Docker Compose)")
System_Ext(prometheus, "Prometheus", "Docker Compose locally")

Rel(api, jaeger, "Traces", "OTLP/HTTP")
Rel(worker, jaeger, "Traces", "OTLP/HTTP JSON")
Rel(worker, api, "Lease returns traceparent; calls send it", "HTTPS (outbound)")
Rel(prometheus, api, "Scrapes /metrics", "HTTP, bearer token")
Rel(api, db, "Readiness: SELECT 1", "SQL")
Rel(api, backplane, "Readiness: send to an empty group")
@enduml
