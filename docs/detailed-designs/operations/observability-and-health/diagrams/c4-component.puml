@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Observability and health checks

ContainerDb(db, "Hewn database", "SQLite", "Runs and their traceparent")
ContainerQueue(backplane, "SignalR lifetime manager", "In-process today (ADR 0035)", "Sends hub messages")
Container(worker, "Worker", "Node.js", "Tracer, jsonLog, OTLP exporter")
Container_Boundary(api_b, "Hewn API") {
  Component(log, "JsonLoggerProvider", "ILoggerProvider", "One JSON line per entry, with scopes and trace IDs")
  Component(scope, "RunLogScopeFilter", "MVC action filter", "Run IDs on every worker call's entries")
  Component(trace, "RunTracing", "ActivitySource Hewn", "Run queued and Run leased spans")
  Component(metrics, "HewnMetrics", "Meter Hewn", "Stage, queue, worker, event, tokens, spend")
  Component(scrape, "MetricsEndpoint", "Prometheus exporter", "/metrics behind the scrape token")
  Component(health, "Health checks", "ASP.NET Core health checks", "/health/live, /health/ready")
}
System_Ext(jaeger, "Trace viewer", "OTLP/HTTP")
System_Ext(prometheus, "Prometheus", "Scraper")

Rel(scope, log, "Opens a scope for")
Rel(trace, jaeger, "Exports", "OTLP/HTTP")
Rel(trace, worker, "traceparent on the lease", "HTTPS")
Rel(scrape, metrics, "Reads")
Rel(prometheus, scrape, "Scrapes", "HTTP, bearer token")
Rel(metrics, db, "Queue depth, active workers", "SQL")
Rel(health, db, "SELECT 1", "SQL")
Rel(health, backplane, "Send to an empty group")
@enduml
