@startuml
title UML sequence behaviour — Trace a run across API, queue and worker
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as projects
  participant "WorkerController" as wc
  participant "RunTracing" as rt
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Worker" #ECFDF3
  participant "WorkLoop" as worker
end box
box "External systems" #F2F4F7
  participant "Trace viewer" as tel
end box
owner -> projects : POST /api/projects (server span, trace T)
projects -> db : Insert run with TraceParent under T
worker -> wc : POST /api/worker/lease
wc -> rt : Queued(run)
rt -> rt : Span "Run queued" from queueing to now, under T
wc -> wc : Span "Run leased"; log "Leased run" with traceId T and run IDs
wc --> worker : Leased run with traceParent of "Run queued"
worker -> worker : Span "Run stage n" under it; log lines carry traceId T
worker -> wc : Model call report, traceparent of span "Model call"
worker -> wc : Result, traceparent of "Run stage n"
wc -> db : Queue the next stage with TraceParent under T
worker -> tel : Spans as OTLP JSON (L2-049 AC2)
wc -> tel : Spans over OTLP (L2-049 AC2)
@enduml
