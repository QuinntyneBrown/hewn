@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Observability and health checks

class Run {
  +Guid Id
  +string? TraceParent
}
class RunTracing <<static>> {
  +ActivitySource Source
  +Queued(run: Run, now): string?
  +Start(name, traceParent): Activity?
}
class LeasedRunDto {
  +string? TraceParent
}
class JsonLoggerProvider {
  +CreateLogger(category): ILogger
  +SetScopeProvider(scopes): void
}
class LogSink {
  +WriteLine(line: string): void
}
class RunLogScopeFilter {
  +OnActionExecutionAsync(context, next): Task
}
class HewnMetrics {
  +RunEnded(run: Run): void
  +EventSent(stored: StoredEvent): void
  +ModelCalled(model, input, output, costUsd): void
}
class DatabaseReadinessCheck {
  +CheckHealthAsync(): Task<HealthCheckResult>
}
class BackplaneReadinessCheck {
  +CheckHealthAsync(): Task<HealthCheckResult>
}
class "Tracer (worker)" as Tracer {
  +start(name, options): Span
}
class "Span (worker)" as Span {
  +traceId: string
  +spanId: string
  +traceParent: string
  +fail(message): void
  +end(): void
}
RunTracing ..> Run : reads TraceParent
LeasedRunDto ..> RunTracing : TraceParent from Queued
JsonLoggerProvider --> LogSink
RunLogScopeFilter ..> JsonLoggerProvider : scope fields
Tracer --> Span : starts
Span ..> LeasedRunDto : continues TraceParent
@enduml
