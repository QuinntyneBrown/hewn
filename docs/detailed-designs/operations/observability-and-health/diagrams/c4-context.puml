@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Observability and health checks

Person(operator, "Operator", "Checks health, reads logs, follows traces and watches metrics")
System(hewn, "Hewn", "Software factory: carries a direction to merged code through a fixed pipeline")
System_Ext(jaeger, "Trace viewer", "Jaeger locally; any OTLP/HTTP receiver")
System_Ext(prometheus, "Prometheus", "Scrapes /metrics with the scrape token")

Rel(operator, hewn, "Probes /health/live and /health/ready", "HTTPS")
Rel(hewn, jaeger, "Exports traces to", "OTLP/HTTP")
Rel(prometheus, hewn, "Scrapes metrics from", "HTTP, bearer token")
Rel(operator, jaeger, "Follows a run's trace in")
@enduml
