@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Archive and delete a project

class Project {
  +ProjectId Id
  +string Name
  +DateTimeOffset? ArchivedAt
  +string? ArchivedBy
  +bool IsArchived
  +bool HasActiveDirection
  +Archive(login, now): bool
  +Restore(): bool
}
class ConflictException {
  +string Code = "active_direction"
  +string Message = "Cancel the running direction first"
}
class DeleteProjectCommand {
  +Guid ProjectId
  +string? ConfirmName
}
class DeleteProjectHandler {
  +Handle(cmd: DeleteProjectCommand): Task
}
class FieldValidationException {
  +string Code = "confirm_name"
}
interface IProjectEventPublisher {
  +ProjectDeletedAsync(projectId): Task
}
class ArchiveProjectHandler {
  +Handle(cmd: ArchiveProjectCommand): Task
}
class RestoreProjectHandler {
  +Handle(cmd: RestoreProjectCommand): Task
}
DeleteProjectHandler ..> DeleteProjectCommand : handles
DeleteProjectHandler --> Project : guards / removes
DeleteProjectHandler ..> FieldValidationException : throws
DeleteProjectHandler --> IProjectEventPublisher : tells Projects pages
ArchiveProjectHandler --> Project : archives
RestoreProjectHandler --> Project : restores
ArchiveProjectHandler ..> ConflictException : throws
DeleteProjectHandler ..> ConflictException : throws
@enduml
