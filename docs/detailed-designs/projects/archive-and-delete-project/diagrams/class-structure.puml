@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Archive and delete a project

class Project {
  +ProjectId Id
  +string Name
  +DateTimeOffset? ArchivedAt
  +string? ArchivedBy
  +bool IsArchived
  +bool HasActiveDirection
  +ProjectLifecycle Lifecycle
  +Archive(login, now): bool
  +Restore(): bool
  +MarkDeleting(): void
}
enum ProjectLifecycle {
  Active
  Deleting
}
class ConflictException {
  +string Code = "active_direction"
  +string Message = "Cancel the running direction first"
}
class DeleteProjectCommand {
  +ProjectId ProjectId
  +string ConfirmName
}
class DeleteProjectHandler {
  +Handle(cmd: DeleteProjectCommand): Task<Result>
}
class ArchiveProjectHandler {
  +Handle(cmd: ArchiveProjectCommand): Task
}
class RestoreProjectHandler {
  +Handle(cmd: RestoreProjectCommand): Task
}
class PurgeProjectJob {
  +ProjectId ProjectId
  +RunAsync(): Task
}
DeleteProjectHandler ..> DeleteProjectCommand : handles
DeleteProjectHandler --> Project : guards / marks
DeleteProjectHandler ..> PurgeProjectJob : enqueues
ArchiveProjectHandler --> Project : archives
RestoreProjectHandler --> Project : restores
ArchiveProjectHandler ..> ConflictException : throws
DeleteProjectHandler ..> ConflictException : throws
Project --> ProjectLifecycle
@enduml
