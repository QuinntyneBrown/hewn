@startuml
title UML sequence behaviour — Delete a project
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "ProjectsPage" as page
  participant "DeleteProjectDialog" as dlg
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as ctrl
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "DeleteProjectHandler" as del
  participant "Project" as proj
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
  participant "SignalRProjectEventPublisher" as hub
end box
owner -> page : Press Delete on a project row
page -> dlg : Open; state that the GitHub repository is kept (L2-003 AC3)
owner -> dlg : Type the project name; press Delete project
dlg -> ctrl : DELETE /api/projects/{id} { confirmName }
ctrl -> del : DeleteProjectCommand
del -> db : Load project with directions
del -> proj : HasActiveDirection
alt active direction
  del --> del : ConflictException active_direction
  del --> ctrl : 409 "Cancel the running direction first" (L2-003 AC2)
  ctrl --> dlg : Show refusal
else confirmName differs
  del --> ctrl : 400 confirm_name "Type {name} exactly to delete it."
  ctrl --> dlg : Invalid state: type the name exactly
else allowed
  del -> db : Remove the project, directions and stages, runs, events, log lines,\ndecisions, model calls, GitHub mutations, increments, checks, skills updates
  del -> db : Save (one transaction: a failure removes nothing)
  note right of db : No GitHub call; the repository is kept
  del -> hub : ProjectDeletedAsync(id)
  hub --> page : ProjectDeleted { projectId } to every Projects page
  del --> ctrl : done
  ctrl --> dlg : 204 No Content
  dlg --> page : Close; row leaves the list; toast "{name} deleted"
end
@enduml
