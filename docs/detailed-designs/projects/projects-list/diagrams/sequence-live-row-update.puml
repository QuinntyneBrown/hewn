@startuml
title UML sequence behaviour — Update a projects row in place
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Frontend — Mission Control application" #E0F2FE
  participant "ProjectsPage" as page
  participant "PROJECT_EVENTS" as live
end box
box "Backend — Hewn API application" #D1FADF
  participant "SignalRProjectEventPublisher" as pub
  participant "MissionControlHub" as hub
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "ProjectSummaryReader" as reader
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
page -> live : followProjects()
live -> hub : JoinProjects (group "projects")
note over pub : Events were stored with their sequence\nand sent to each project's group
pub -> reader : ReadAsync(changed project)\n(not for LogLines or DecisionRecorded)
reader -> db : One project's row
db --> reader : ProjectSummaryDto
pub -> hub : ProjectSummary to group "projects" (ADR 0016)
hub -> live : ProjectSummary (within 1 s, L2-031 AC1)
live -> page : {kind: 'row', row}
page -> page : upsertRow, sorted newest first (L2-002 AC4)
live -> page : {kind: 'resync'} after a reconnect
page -> page : Load the list again
@enduml
