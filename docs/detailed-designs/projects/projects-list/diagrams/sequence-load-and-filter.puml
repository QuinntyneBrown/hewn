@startuml
title UML sequence behaviour — Load and filter the projects list
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "ProjectsPage" as page
  participant "PROJECTS_API" as client
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as ctrl
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "ListProjectsHandler" as handler
  participant "ProjectSummaryReader" as reader
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
user -> page : Open /projects?status=blocked
page -> page : parseStatusFilter from the query string (L2-002 AC2)
page -> client : list()
client -> ctrl : GET /api/projects
ctrl -> handler : ListProjectsQuery
handler -> reader : ReadAsync(all projects)
reader -> db : Projects with directions, leased runs, increments, latest event (ADR 0016)
db --> reader : Rows
reader --> handler : ProjectSummaryDto[]
handler --> ctrl : Sorted by last activity, newest first (L2-002 AC1)
ctrl --> client : 200
client --> page : rows
alt no projects at all
  page --> user : Empty state; New product only for Owners (L2-002 AC3)
else rows
  page --> user : Tabs with counts; the rows with the chosen status
end
user -> page : Choose a tab
page -> page : Navigate to ?status=running; filter the loaded rows
@enduml
