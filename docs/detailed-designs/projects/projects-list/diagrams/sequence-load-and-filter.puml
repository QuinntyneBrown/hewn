@startuml
title UML sequence behaviour — Load and filter the projects list
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "ProjectsPage" as page
  participant "ProjectsStore" as store
  participant "ProjectsApi" as client
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as ctrl
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "ProjectSummaryQuery" as query
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
user -> page : Open /projects?status=Blocked
page -> store : load(Blocked) from query string (L2-002 AC2)
store -> client : GET /api/projects?status=Blocked
client -> ctrl : HTTPS request
ctrl -> query : ProjectsQuery for the caller
query -> db : Select accessible summaries, order by last activity desc (L2-002 AC1)
db --> query : Rows
query --> ctrl : ProjectSummaryDto[]
ctrl --> client : 200
client --> store : rows
alt no projects at all
  store --> page : Empty state; New product only for Owners (L2-002 AC3)
else rows
  store --> page : Render rows with stage, status, percent, spend, activity
end
@enduml
