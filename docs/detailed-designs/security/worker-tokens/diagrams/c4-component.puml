@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Worker tokens

Container(spa, "Mission Control", "Angular", "Web frontend: give direction and watch the work")
Container(worker, "Worker", "Container image, Claude Agent SDK", "Leases runs and executes stages, local or cloud")
ContainerDb(db, "Hewn database", "Relational database", "Projects, directions, runs, workers, worker tokens")
Container_Boundary(api_b, "Hewn API") {
  Component(ctrl, "WorkerTokensController", "ASP.NET Core controller", "Create a token, shown once")
  Component(wctrl, "WorkersController", "ASP.NET Core controller", "Revoke a worker")
  Component(create, "CreateWorkerTokenHandler", "MediatR handler", "Generate, hash, expire")
  Component(revoke, "RevokeWorkerHandler", "MediatR handler", "Revoke, release the lease, stop the worker")
  Component(auth, "WorkerTokenAuthenticationHandler", "Auth handler", "Hash and verify the bearer token")
}

Rel(spa, ctrl, "Calls", "JSON/HTTPS")
Rel(spa, wctrl, "Calls", "JSON/HTTPS")
Rel(ctrl, create, "Sends")
Rel(wctrl, revoke, "Sends")
Rel(create, db, "Stores the hash", "SQL")
Rel(revoke, db, "Revokes, releases", "SQL")
Rel(worker, auth, "Bearer token on every request", "HTTPS")
Rel(auth, db, "Looks up by hash", "SQL")
@enduml
