@startuml
title UML sequence behaviour — Create and revoke a worker token
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "WorkerTokenDialog\nRevokeWorkerDialog" as dlg
end box
box "Backend — Hewn API application" #D1FADF
  participant "WorkerTokensController\nWorkersController" as ctrl
  participant "WorkerTokenAuthenticationHandler" as auth
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "CreateWorkerTokenHandler\nRevokeWorkerHandler" as svc
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "WorkLoop" as worker
end box
owner -> dlg : Name "studio-mac", Local, in 90 days
dlg -> ctrl : POST /api/worker-tokens
ctrl -> svc : CreateWorkerTokenCommand
svc -> db : Store SHA-256 hash, ExpiresAt = now + 90 d (L2-041 AC1, AC3)
svc --> dlg : 201 hwt_... (no-store), shown once
== the worker starts with the token ==
worker -> auth : Register, Bearer hwt_...
auth -> db : Find by hash; valid?
auth --> worker : Registered as "studio-mac", Local
worker -> ctrl : Lease; control poll held open while it runs
== later ==
owner -> dlg : Revoke studio-mac
dlg -> ctrl : POST /api/workers/{id}/revoke
ctrl -> svc : RevokeWorkerCommand
svc -> db : RevokedAt = now; halt and release its run (L2-041 AC2)
svc --> dlg : 204
worker -> auth : Next control poll or heartbeat
auth --> worker : 401
worker -> worker : Abort the step, exit 3 (within 10 s)
@enduml
