@startuml
title UML sequence behaviour — Supply a credential and redact output (as built)
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Operator" as op
box "Operator's machine or cloud shell" #F2F4F7
  participant "hewn secret" as cli
end box
box "Backend — Hewn API application" #D1FADF
  participant "CredentialsController" as ctrl
  participant "Worker endpoints" as ingest
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "SecretRedactor" as red
  participant "EventAppender" as events
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  participant "Secret store\n(Key Vault or OS key store)" as vault
  database "Hewn database" as db
end box
box "Worker" #E0F2FE
  participant "WorkLoop" as worker
end box
op -> cli : secret set model-api-key\n(value on standard input)
cli -> vault : SetAsync — encrypted at rest (L2-040 AC1)
== API and worker start ==
ctrl -> vault : read each credential into configuration
ctrl -> red : Remember(value)
worker -> vault : read worker credentials (HEWN_SECRET_STORE=os)
op -> ctrl : GET /api/settings/credentials
ctrl -> vault : ListAsync
ctrl --> op : [{name, description, updatedAt}] — no value
== A run ==
worker -> worker : redact(line) before sending
worker -> ingest : POST logs "model key ***"
ingest -> red : Redact(text) (L2-040 AC2)
ingest -> db : store redacted line
ingest -> events : Append LogLines
events -> red : RedactJson(payload)
events -> db : store and broadcast
worker -> worker : run ends: removeWorkspace (L2-040 AC3)
@enduml
