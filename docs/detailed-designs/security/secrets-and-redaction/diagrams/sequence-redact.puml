@startuml
title UML sequence behaviour — Store a secret and redact output
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "SettingsPage" as spa
end box
box "Backend — Hewn API application" #D1FADF
  participant "SettingsController" as ctrl
  participant "LogLineSink" as logs
end box
box "Backend — Hewn Application and Domain" #ECFDF3
  participant "Redactor" as red
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  participant "Secret store" as vault
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "WorkerHost" as worker
end box
owner -> spa : Paste model API key
spa -> ctrl : PUT /api/settings/secrets/model-api-key
ctrl -> vault : SetAsync (encrypted at rest) (L2-040 AC1)
ctrl -> red : Refresh known values
ctrl --> spa : SecretRef {name, updatedAt} - no value
worker -> logs : Log line "using key sk-ant-api03-..."
logs -> red : Redact(text)
red --> logs : "using key ***" (L2-040 AC2)
logs -> db : Store redacted line
worker -> worker : Run ends: scrub workspace credentials (L2-040 AC3)
@enduml
