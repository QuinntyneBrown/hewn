@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Secrets and redaction

Person(owner, "Owner", "Gives direction, watches the work and uses the safety controls")
System_Boundary(hewn, "Hewn") {
  Container(spa, "Mission Control", "Angular", "Web frontend: give direction and watch the work")
  Container(api, "Hewn API", "ASP.NET Core, SignalR", "REST endpoints, the Mission Control hub and orchestration")
  ContainerDb(db, "Hewn database", "SQLite", "Projects, directions, runs, events, spend, audit")
  Container(worker, "Worker", "Node.js", "Leases runs and executes stages, local or cloud")
  Container(cli, "hewn CLI", ".NET", "secret set reads a value on standard input")
}
System_Ext(vault, "Secret store", "Azure Key Vault in the cloud, macOS keychain or Linux Secret Service locally")

Rel(owner, cli, "Supplies a credential", "standard input")
Rel(cli, vault, "Stores encrypted", "HTTPS or key store tool")
Rel(owner, spa, "Sees credential references", "HTTPS")
Rel(spa, api, "GET /api/settings/credentials", "JSON/HTTPS")
Rel(api, vault, "Stores and reads secrets", "HTTPS")
Rel(api, db, "Redacted logs and events", "SQL")
Rel(worker, api, "Redacted logs", "HTTPS (outbound)")
Rel(worker, vault, "Reads its credentials", "key store tool or Key Vault references")
@enduml
