@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Secrets and redaction

Container(worker, "Worker", "Node.js", "Redacts before sending; deletes the workspace at run end")
ContainerDb(db, "Hewn database", "SQLite", "Run log lines, events")
System_Ext(github, "GitHub", "Pull requests")
System_Ext(vault, "Secret store", "Azure Key Vault in the cloud, macOS keychain or Linux Secret Service locally")
Container_Boundary(api_b, "Hewn API") {
  Component(cfg, "SecretStoreConfigurationSource", "Configuration", "Credentials into configuration keys")
  Component(store, "ISecretStore", "Abstraction", "Key Vault, OS key store or memory")
  Component(list, "CredentialsController", "GET /api/settings/credentials", "Names and last-updated times only")
  Component(red, "SecretRedactor", "Application", "Stored values and token patterns -> ***")
  Component(logs, "AppendRunLogHandler", "Ingest", "Redacts lines before storing")
  Component(events, "EventAppender", "Event store", "Redacts every string before appending")
  Component(pr, "OpenPullRequestHandler", "GitHub broker", "Redacts title and body before sending")
  Component(json, "JsonLoggerProvider", "Logging", "Redacts server log entries")
}

Rel(cfg, store, "Reads at start and on change")
Rel(store, vault, "Encrypted at rest", "HTTPS or key store tool")
Rel(cfg, red, "Remember(value)")
Rel(list, store, "ListAsync")
Rel(worker, logs, "Redacted log lines", "HTTPS")
Rel(logs, red, "Redact")
Rel(events, red, "RedactJson")
Rel(pr, red, "Redact")
Rel(json, red, "Redact")
Rel(logs, db, "Stores", "SQL")
Rel(events, db, "Stores", "SQL")
Rel(pr, github, "Opens", "HTTPS")
@enduml
