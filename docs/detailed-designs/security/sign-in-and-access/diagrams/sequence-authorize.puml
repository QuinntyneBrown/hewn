@startuml
title UML sequence behaviour — Authorize a request
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Viewer" as viewer
box "Frontend — Mission Control application" #E0F2FE
  participant "Mission Control" as spa
end box
box "Backend — Hewn API application" #D1FADF
  participant "Authorization policies" as pol
  participant "Project handlers" as handlers
  participant "MissionControlHub" as hub
end box
viewer -> spa : (crafted) POST /api/projects/{id}/directions/{d}/pause
spa -> pol : OwnerPolicy
pol --> spa : 403, whatever the request holds (L2-039 AC1)
viewer -> spa : GET /api/projects/{other}
spa -> handlers : Find the project
handlers --> spa : 404 not_found, the same as a project that never existed (L2-039 AC2)
spa -> hub : JoinProject(other)
hub --> spa : Group refused, "Project not found."
viewer -> spa : Open Settings
spa --> viewer : Who can sign in, read-only (L2-038 AC5)
@enduml
