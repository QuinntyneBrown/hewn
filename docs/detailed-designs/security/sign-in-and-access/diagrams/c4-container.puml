@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign-in and access control

Person(owner, "Owner", "Gives direction, watches the work and uses the safety controls")
Person(viewer, "Viewer", "Watches every project read-only")
System_Boundary(hewn, "Hewn") {
  Container(spa, "Mission Control", "Angular", "Web frontend: give direction and watch the work")
  Container(api, "Hewn API", "ASP.NET Core, SignalR", "REST endpoints, the Mission Control hub and orchestration")
  ContainerDb(db, "Hewn database", "Relational database, engine <TO SUPPLY>", "Projects, directions, runs, events, spend, audit")
}
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")

Rel(owner, spa, "Signs in", "HTTPS")
Rel(spa, api, "Requests with session cookie", "JSON/HTTPS, SignalR")
Rel(api, github, "OAuth code exchange", "HTTPS")
Rel(api, db, "Allow list, sessions revocation", "SQL")
@enduml
