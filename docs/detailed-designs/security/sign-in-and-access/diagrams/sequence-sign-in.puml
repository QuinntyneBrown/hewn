@startuml
title UML sequence behaviour — Sign in with GitHub
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "User" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "SignInPage" as spa
end box
box "Backend — Hewn API application" #D1FADF
  participant "MissionControlPages" as pages
  participant "AuthController" as auth
  participant "SignInWithGitHubCommand" as cmd
  participant "IGitHubIdentity" as ident
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
user -> pages : GET /projects (no session)
pages --> user : 302 /sign-in?returnUrl=%2Fprojects (APIs and hubs: 401) (L2-038 AC1)
user -> spa : Continue with GitHub
spa -> auth : GET /api/auth/github?returnUrl=/projects
auth --> user : 302 GitHub authorize, state; Set-Cookie hewn.oauth (protected, 10 min)
user -> gh : Authorize Hewn
gh --> user : 302 /api/auth/github/callback?code&state
user -> auth : Callback with code, state and hewn.oauth
alt state missing or forged, or GitHub fails (30 s)
  auth --> user : 302 /sign-in?error=github
else cancelled on GitHub
  auth --> user : 302 /sign-in
else
  auth -> cmd : Send(code, redirectUri)
  cmd -> ident : LoginForCodeAsync
  ident -> gh : Exchange code; read login
  cmd -> db : Find allow-list entry
  alt not on list
    auth --> user : 302 /sign-in?error=denied&login (L2-038 AC2)
  else Owner or Viewer
    auth --> user : 302 returnUrl; Set-Cookie hewn.session HttpOnly; Secure; SameSite=Lax; 8 h absolute; hewn:sid (L2-038 AC3, AC4)
  end
end
@enduml
