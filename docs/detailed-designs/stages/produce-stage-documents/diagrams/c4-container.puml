@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Produce and validate stage documents

System_Boundary(hewn, "Hewn") {
  Container(api, "Hewn API", "ASP.NET Core, SignalR", "REST endpoints, the Mission Control hub and orchestration")
  ContainerDb(db, "Hewn database", "Relational database, engine <TO SUPPLY>", "Projects, directions, runs, events, spend, audit")
  Container(worker, "Worker", "Container image, Claude Agent SDK", "Leases runs and executes stages, local or cloud")
}
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")
System_Ext(claude, "Claude model API", "Anthropic models, called through the Claude Agent SDK")

Rel(worker, api, "Leases the run, reports progress and result", "HTTPS, SignalR (outbound)")
Rel(api, db, "Stores run, logs and artifact versions", "SQL")
Rel(worker, claude, "Runs stage agent", "HTTPS")
Rel(worker, api, "Commits documents via the git proxy", "Git smart HTTP (outbound)")
Rel(api, github, "Forwards fenced pushes and PR mutations", "Git/HTTPS, GitHub App")
@enduml
