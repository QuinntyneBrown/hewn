@startuml
title UML sequence behaviour — Update a project's skills
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "ProjectPage" as page
  participant "UpdateSkillsDialog" as dlg
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as ctrl
  participant "GetSkillsUpdate / UpdateSkills handlers" as h
  participant "GitSkillsSource" as src
  participant "SkillsUpdateMerger (every 10 s)" as merge
end box
box "External systems" #F2F4F7
  participant "Greenlit (git)" as greenlit
  participant "GitHub" as gh
end box
page -> ctrl : GET /api/projects/{id}/skills-update (Owners only)
ctrl -> h : GetSkillsUpdateQuery
h -> gh : Read .hewn/skills.lock at the default branch
h -> src : CommitsSinceAsync(locked SHA)
src -> greenlit : fetch (at most once a minute); git log {sha}..HEAD
h --> page : {available: 4, commits, pullRequest: null}
page -> page : "Skills update available (4 commits)" (L2-008 AC1)
owner -> dlg : Update skills
dlg -> ctrl : POST /api/projects/{id}/skills-update
alt Greenlit unreachable
  ctrl --> dlg : 502 greenlit_unreachable
  dlg -> dlg : "Skills weren't updated" and Try again
else
  h -> src : SkillFilesAsync(head)
  h -> gh : Commit skills and lock to hewn/update-skills-{short-sha}; open PR
  h -> h : Record skills_updates row; append SkillsUpdateOpened
  ctrl --> dlg : {pullRequest}
  dlg --> page : Toast; link hidden while the PR is open
end
loop every 10 s while open
  merge -> gh : List checks
  alt every check passed
    merge -> gh : Merge (rebase first if the default branch moved)
    merge -> merge : SkillsUpdateMerged (L2-008 AC2, L2-025)
  else a check failed
    merge -> merge : ChecksFailed; PR left open; update offered again
  end
end
@enduml
