@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Bootstrap and update skills

Container(api, "Hewn API", "ASP.NET Core, SignalR", "REST endpoints, the Mission Control hub and orchestration")
Container_Boundary(worker_b, "Worker") {
  Component(boot, "BootstrapStageExecutor", "Stage executor", "Stage 0: copy skills, write lock, commit")
  Component(upd, "UpdateSkillsExecutor", "Run executor", "Refresh skills on a branch and open a PR")
  Component(copier, "SkillCopier", "Worker service", "Copies folders, keeps existing ones")
  Component(lock, "SkillsLockWriter", "Worker service", "Writes .hewn/skills.lock")
}
System_Ext(greenlit, "Greenlit repository", "github.com/QuinntyneBrown/greenlit, the skill source")
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")

Rel(api, boot, "Leases stage 0 run", "HTTPS")
Rel(boot, copier, "Uses")
Rel(boot, lock, "Uses")
Rel(upd, copier, "Uses")
Rel(upd, lock, "Uses")
Rel(copier, greenlit, "Fetches", "Git/HTTPS")
Rel(boot, github, "Commits", "Git/HTTPS")
Rel(upd, github, "Pushes branch, opens PR", "HTTPS")
@enduml
