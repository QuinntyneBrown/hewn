@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Bootstrap and update skills

Container_Boundary(api_b, "Hewn API") {
  Component(get, "GetSkillsUpdateHandler", "MediatR handler", "Commits after the locked SHA (L2-008 AC1)")
  Component(upd, "UpdateSkillsHandler", "MediatR handler", "Commits skills and lock to a branch, opens the PR")
  Component(merge, "SkillsUpdateMerger", "Application service, every 10 s", "Merges once checks pass; rebases; records failures")
  Component(src, "GitSkillsSource", "Infrastructure", "Bare clone of Greenlit, fetched at most once a minute")
}
Container_Boundary(worker_b, "Worker") {
  Component(boot, "BootstrapStageExecutor", "Stage executor", "Stage 0: copy skills, write lock, commit")
}
System_Ext(greenlit, "Greenlit repository", "github.com/QuinntyneBrown/greenlit, the skill source")
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")

Rel(boot, greenlit, "Clones", "Git/HTTPS")
Rel(boot, github, "Commits through the API", "HTTPS")
Rel(get, src, "Uses")
Rel(upd, src, "Uses")
Rel(merge, src, "Uses when rebasing")
Rel(src, greenlit, "Fetches", "Git/HTTPS")
Rel(get, github, "Reads .hewn/skills.lock", "HTTPS")
Rel(upd, github, "Commits branch, opens PR", "HTTPS")
Rel(merge, github, "Lists checks, merges", "HTTPS")
@enduml
