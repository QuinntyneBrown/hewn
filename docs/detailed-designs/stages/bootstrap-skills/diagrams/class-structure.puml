@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Bootstrap and update skills

class SkillsLock {
  +string Source
  +string Sha
  +string[] Skills
}
class SkillCopier <<worker>> {
  +CopyAsync(src: Checkout, dst: Workspace): CopyReport
}
class CopyReport {
  +string[] Copied
  +string[] KeptExisting
}
class BootstrapStageExecutor <<worker>> {
  +ExecuteAsync(ctx: StageContext): Task<StageResult>
}
class SkillsUpdate {
  +Guid ProjectId
  +string FromSha
  +string ToSha
  +string Branch
  +int PullRequestNumber
  +SkillsUpdateStatus Status
  +Merged(now)
  +ChecksFailed(checks, now)
}
enum SkillsUpdateStatus {
  Open
  Merged
  ChecksFailed
}
interface ISkillsSource {
  +HeadAsync(): Task<string>
  +CommitsSinceAsync(sha): Task<SkillsCommit[]>
  +SkillFilesAsync(sha): Task<RepositoryFile[]>
}
class GitSkillsSource
class UpdateSkillsHandler {
  +Handle(UpdateSkillsCommand): Task<UpdateSkillsResult>
}
class SkillsUpdateMerger {
  +SweepAsync(): Task<int>
}
BootstrapStageExecutor ..> SkillCopier
BootstrapStageExecutor ..> SkillsLock : writes
SkillCopier ..> CopyReport
GitSkillsSource ..|> ISkillsSource
UpdateSkillsHandler ..> ISkillsSource
UpdateSkillsHandler ..> SkillsLock : reads, rewrites
UpdateSkillsHandler ..> SkillsUpdate : records
SkillsUpdateMerger ..> SkillsUpdate : merges
SkillsUpdate ..> SkillsUpdateStatus
@enduml
