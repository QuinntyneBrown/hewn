@startuml
title UML sequence behaviour — View the backlog
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "BacklogPage" as page
end box
box "Backend — Hewn API application" #D1FADF
  participant "BacklogController" as ctrl
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
user -> page : Open Backlog
page -> ctrl : GET /api/projects/{id}/backlog
ctrl -> db : Read BacklogIndex and deferred items
ctrl --> page : Increments and deferred
page --> user : Active table: status, estimate, PR link (L2-020 AC2)
page --> user : Deferred section with reasons (L2-019 AC4)
@enduml
