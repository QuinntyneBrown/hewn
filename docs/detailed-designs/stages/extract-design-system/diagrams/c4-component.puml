@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Extract the design system

Container(api, "Hewn API", "ASP.NET Core, SignalR", "REST endpoints, the Mission Control hub and orchestration")
Container_Boundary(worker_b, "Worker") {
  Component(exec, "DesignSystemStageExecutor", "Stage executor", "Stage 3")
  Component(agent, "StageAgent", "Claude Agent SDK session", "extracting-design-systems skill")
  Component(out, "DesignSystemOutputValidator", "Validator", "Token groups and component pages present")
  Component(cov, "TokenCoverageValidator", "Validator", "Every mock colour matches a token")
  Component(cmp, "MagicPatternsTokenComparer", "Checker", "Logs mismatches with Magic Patterns settings")
}
System_Ext(magic, "Magic Patterns", "Design tool reached through its MCP server")
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")

Rel(api, exec, "Leases run", "HTTPS")
Rel(exec, agent, "Runs")
Rel(exec, out, "Validates")
Rel(exec, cov, "Validates")
Rel(exec, cmp, "Compares")
Rel(cmp, magic, "Reads settings", "MCP")
Rel(exec, github, "Commits", "Git/HTTPS")
@enduml
