@startuml
title UML sequence behaviour — Cancel a direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "CancelDirectionDialog" as dlg
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as dc
  participant "WorkerController" as wc
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "WorkLoop" as loop
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
loop -> wc : GET runs/{id}/control?waitSeconds=20 (held open)
owner -> dlg : Confirm Cancel direction
dlg -> dc : POST /api/projects/{p}/directions/{d}/cancel
dc -> dc : Require Owner, else 403 (L2-029 AC5)
dc -> gh : Label each open PR the direction opened hewn:cancelled
dc -> db : DirectionCancelled; run, stage, direction Cancelled;\nnext queued direction starts, else project Cancelled (L2-004 AC4)
dc -> wc : Wake the held poll
wc -> db : Stop acknowledged; "Run stopped at step n"
wc --> loop : 200 {control: Cancel}
loop -> loop : Abort the step in progress; report nothing more
alt the worker answers within 10 s
  dc --> dlg : 200 {stopped: true, stoppedWithinSeconds}; dialog closes
else no answer within 10 s
  dc --> dlg : 200 {stopped: false, worker}; "Cancel didn't reach the worker", Try again
end
db --> dlg : Events: Cancelled by … on … at …; PR #n labelled (L2-029 AC3)
@enduml
