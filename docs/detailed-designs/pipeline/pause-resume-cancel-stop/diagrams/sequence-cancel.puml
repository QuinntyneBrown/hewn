@startuml
title UML sequence behaviour — Cancel a direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "CancelDirectionDialog" as dlg
end box
box "Backend — Hewn API application" #D1FADF
  participant "DirectionControlsController" as dc
  participant "WorkerControlChannel" as chan
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  participant "PullRequestLabeler" as labeler
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "RunSupervisor" as sup
end box
box "External systems" #F2F4F7
  participant "GitHub" as gh
end box
owner -> dlg : Confirm Cancel direction
dlg -> dc : POST /api/directions/{id}/cancel
dc -> chan : CancelRun(run)
chan -> sup : CancelRun
sup -> sup : Cancel agent; kill run container if still alive at 10 s
sup --> chan : Stopped
alt no acknowledgement within 10 s
  chan -> db : Expire lease; run will not resume
end
dc -> db : Direction Cancelled; active stage Cancelled
dc -> labeler : LabelOpenAsync(direction, hewn:cancelled)
labeler -> gh : Add label to each open PR (L2-029 AC3)
dc --> dlg : Close; header shows Cancelled
@enduml
