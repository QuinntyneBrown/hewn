@startuml
title UML sequence behaviour — Pause and resume a direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "DirectionControlsComponent" as ctl
end box
box "Backend — Hewn API application" #D1FADF
  participant "DirectionControlsController" as dc
  participant "WorkerControlChannel" as chan
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "RunSupervisor" as sup
end box
owner -> ctl : Press Pause
ctl -> dc : POST /api/directions/{id}/pause
dc -> dc : Require Owner (L2-029 AC5)
dc -> chan : PauseAfterStep(run)
chan -> sup : PauseAfterStep
sup -> sup : Finish current step; commit checkpoint
sup --> chan : Paused at checkpoint
chan -> db : Direction Paused; stage Paused (L2-029 AC1)
dc --> ctl : Header shows Resume
owner -> ctl : Press Resume
ctl -> dc : POST /api/directions/{id}/resume
dc -> db : Direction Running; insert run from next step (L2-029 AC2)
dc --> ctl : Header shows Pause
@enduml
