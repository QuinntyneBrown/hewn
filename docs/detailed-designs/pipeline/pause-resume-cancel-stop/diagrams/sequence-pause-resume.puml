@startuml
title UML sequence behaviour — Pause and resume a direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner" as owner
box "Frontend — Mission Control application" #E0F2FE
  participant "ProjectPage header" as ctl
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as dc
  participant "WorkerController" as wc
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "Backend — Worker application" #D1FADF
  participant "WorkLoop" as loop
end box
owner -> ctl : Press Pause
ctl -> dc : POST /api/projects/{p}/directions/{d}/pause
dc -> dc : Require Owner, else 403 (L2-029 AC5)
dc -> db : PauseRequested; "Pause requested by" in the run log
dc --> ctl : 200 {status: Running, pauseRequested: true}; header shows Pausing…
loop -> loop : Finish the step in progress
loop -> wc : POST checkpoints {step, sha}
wc -> db : Checkpoint; run Paused, lease released;\nstage, direction, project Paused (L2-029 AC1)
wc --> loop : 200 {verdict: Pause}
loop -> loop : End the run: no next step, no result
db --> ctl : Events: Paused by … at …; header shows Resume
owner -> ctl : Press Resume
ctl -> dc : POST /api/projects/{p}/directions/{d}/resume
dc -> db : DirectionResumed; run Queued with its checkpoint;\nstage, direction, project Running (L2-029 AC2)
dc --> ctl : 200 {status: Running}; header shows Pause
loop -> wc : POST lease
wc --> loop : Same run, next epoch, checkpointStep n
loop -> loop : Start at step n + 1; no completed step runs twice (L2-050 AC3)
@enduml
