@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Run a direction through the pipeline

Person(owner, "Owner", "Gives direction, watches the work and uses the safety controls")
System(hewn, "Hewn", "Software factory: carries a direction to merged code through a fixed pipeline")
System_Ext(github, "GitHub", "Target repositories, pull requests, checks, GitHub App and webhooks")
System_Ext(claude, "Claude model API", "Anthropic models, called through the Claude Agent SDK")

Rel(owner, hewn, "Submits directions to")
Rel(hewn, claude, "Runs stage agents with", "Claude Agent SDK")
Rel(hewn, github, "Commits stage outputs and merges pull requests in", "GitHub App")
@enduml
