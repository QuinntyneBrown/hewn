@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Run a direction through the pipeline

Container(worker, "Worker", "Container image, Claude Agent SDK", "Leases runs and executes stages, local or cloud")
ContainerDb(db, "Hewn database", "Relational database, engine <TO SUPPLY>", "Projects, directions, runs, events, spend, audit")
Container_Boundary(api_b, "Hewn API") {
  Component(orch, "PipelineOrchestrator", "Application service", "Advances directions stage by stage")
  Component(plan, "StagePlan", "Domain service", "Ordered stages for product or feature direction")
  Component(dir, "Direction", "Domain entity", "Status and eleven stage states")
  Component(queue, "DirectionQueue", "Domain service", "One active direction per project, FIFO")
  Component(runs, "RunQueue", "Repository", "Leasable runs")
}

Rel(worker, runs, "Leases runs from", "HTTPS")
Rel(worker, orch, "Reports RunSucceeded", "HTTPS")
Rel(orch, plan, "Asks next stage")
Rel(orch, dir, "Advances / marks Skipped")
Rel(orch, queue, "Promotes next direction")
Rel(orch, runs, "Inserts next run")
Rel(runs, db, "Stores", "SQL")
@enduml
