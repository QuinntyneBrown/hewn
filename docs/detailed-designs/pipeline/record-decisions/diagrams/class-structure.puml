@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Record agent decisions

class RunDecision {
  +Guid RunId
  +Guid ProjectId
  +int Stage
  +string Question
  +string Answer
  +string Rationale
  +DateTimeOffset RecordedAt
  +string? CommitSha
  +string? Adr
}
class UserQuestionInterceptor <<worker>> {
  +OnUserQuestion(q: string, ctx: StageContext): Task<string>
}
class DecisionLog <<worker>> {
  +appendDecision(dir, d: Decision): void
  +parseDecisions(text): ReportedDecision[]
  +validateDecisions(dir): string[]
}
class RecordDecisionsHandler {
  +Handle(RecordDecisionsCommand): Task
}
class GetDecisionsHandler {
  +Handle(GetDecisionsQuery(projectId, stage?)): Task<DecisionsDto>
}
class ProjectsController {
  +Decisions(projectId, stage?): Task<DecisionsDto>
}
class DecisionsComponent <<frontend>> {
  +projectId, repository, stage, changes
}
UserQuestionInterceptor ..> DecisionLog : records
DecisionLog ..> RecordDecisionsHandler : reported after the commit
RecordDecisionsHandler ..> RunDecision : stores with commit SHA
GetDecisionsHandler ..> RunDecision : lists newest first
ProjectsController ..> GetDecisionsHandler
DecisionsComponent ..> ProjectsController : GET decisions?stage=
@enduml
