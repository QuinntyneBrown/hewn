@startuml
title UML sequence behaviour — Answer and record a skill question
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
box "Backend — Worker stage execution" #ECFDF3
  participant "StageAgent" as agent
  participant "UserQuestionInterceptor" as icpt
  participant "DecisionAgent" as decide
  participant "DecisionRecorder" as rec
end box
box "Backend — Hewn API application" #D1FADF
  participant "WorkerRunsController" as ctrl
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
box "External systems" #F2F4F7
  participant "GitHub (via write broker)" as gh
end box
agent -> icpt : Ask user: "Who approves a reconciled period?"
icpt -> decide : AnswerAsync(question, direction, brief, artifacts)
decide --> icpt : Answer, rationale, architectural=false
icpt -> rec : RecordAsync(draft)
rec -> rec : Append date, stage, question, answer, rationale to docs/decisions.md (L2-054 AC2)
opt architectural
  rec -> rec : Write docs/adr/NNNN-title.md
end
rec -> gh : Commit docs/decisions.md (and the ADR) through the write broker
rec -> ctrl : POST /api/worker/runs/{id}/decisions\n(question, answer, rationale, adr?)
ctrl -> db : Find the run's latest commit of docs/decisions.md
ctrl -> db : Insert into run_decisions with that commit SHA;\nappend DecisionRecorded
icpt --> agent : Answer; no wait (L2-054 AC1)
@enduml
