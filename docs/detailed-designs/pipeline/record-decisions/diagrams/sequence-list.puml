@startuml
title UML sequence behaviour — List decisions in Mission Control
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "DecisionsPage" as page
end box
box "Backend — Hewn API application" #D1FADF
  participant "DecisionsController" as ctrl
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
user -> page : Open Decisions; choose stage Stack
page -> ctrl : GET /api/projects/{id}/decisions?stage=4
ctrl -> db : Select by project and stage order by date desc
db --> ctrl : Decisions
ctrl --> page : DecisionDto[] (L2-054 AC3)
page --> user : Cards with question, answer, rationale and commit link
@enduml
