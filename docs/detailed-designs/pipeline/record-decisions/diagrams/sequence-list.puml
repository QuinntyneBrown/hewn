@startuml
title UML sequence behaviour — List decisions in Mission Control
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam sequenceMessageAlign left
actor "Owner or Viewer" as user
box "Frontend — Mission Control application" #E0F2FE
  participant "DecisionsComponent" as page
end box
box "Backend — Hewn API application" #D1FADF
  participant "ProjectsController" as ctrl
  participant "GetDecisionsHandler" as handler
end box
box "Backend — Hewn Infrastructure" #FFF4E5
  database "Hewn database" as db
end box
user -> page : Open Decisions; choose stage Stack
page -> page : Navigate to /projects/{id}/decisions?stage=4
page -> ctrl : GET /api/projects/{id}/decisions?stage=4
ctrl -> handler : GetDecisionsQuery(projectId, 4)
handler -> db : run_decisions where project and stage
db --> handler : Decisions with commit SHA and ADR
handler --> ctrl : DecisionsDto, newest first (L2-054 AC3)
ctrl --> page : 200 JSON
page --> user : Question, answer, rationale, stage, time,\ncommit link and ADR link
opt DecisionRecorded event
  page -> ctrl : GET decisions again
end
@enduml
